[Unit]
Description=k0s - Zero Friction Kubernetes
Documentation=https://docs.k0sproject.io
ConditionFileIsExecutable=/usr/bin/k0s
StartLimitIntervalSec=5
StartLimitBurst=10

After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/k0s controller --enable-worker=true --no-taints=true --single=true --config /root/.k0s/k0s.yaml --disable-components=kube-proxy,metrics-server --kubelet-extra-args="--node-ip={{all_ips[0]}}"

RestartSec=10
Delegate=yes
KillMode=process
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
LimitNOFILE=999999
Restart=always

[Install]
WantedBy=multi-user.target
